# ---------------------------------------------------------------------------
# apps/web — Next.js dashboard
# Copy to .env.local:   cp .env.example .env.local
#
# Values prefixed NEXT_PUBLIC_ are inlined into the browser bundle at build
# time: never put a secret in one. Everything under "server-only" stays on the
# Next.js server.
# ---------------------------------------------------------------------------

# Base URL of the Sorolens REST API, used by the browser and by server
# components/route handlers. Required.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical public origin of this dashboard. Used for sitemap.xml entries.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin advertised in robots.txt (absolute URLs for crawlers).
# Defaults to https://sorolens.dev when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry DSN for browser error reporting. Leave empty to disable entirely.
NEXT_PUBLIC_SENTRY_DSN=

# Progressive Web App: service worker + install prompt.
# The service worker is disabled in development unless this is exactly "true",
# and always enabled in a production build. Off by default.
NEXT_PUBLIC_PWA_ENABLED=false

# Plausible Analytics domain (cookieless). The script is only rendered in a
# production build and only when this is set. Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- server-only (never prefix these with NEXT_PUBLIC_) --------------------

# Web Push / VAPID key pair. Both keys are required to enable push
# notifications; /api/push/vapid-public-key returns 503 while they are unset.
# Generate a pair once with:
#   node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact URI (mailto: or https:) placed in the VAPID JWT "sub" claim.
VAPID_SUBJECT=mailto:admin@sorolens.dev

# Shared secret that the API must present in the x-push-secret header when it
# calls PUT /api/push/subscribe. If this is empty the guard is skipped and the
# endpoint accepts unauthenticated calls — always set it in production.
PUSH_INTERNAL_SECRET=

# --- end-to-end tests only -------------------------------------------------

# Port the Playwright suite expects the API on; it builds the test-time
# NEXT_PUBLIC_API_URL from it. Defaults to 8080.
API_PORT=8080
